<UserControl x:Class="UncensoredStudio.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UncensoredStudio.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SetupWizardViewModel}"
             Background="#D9090A10">
    <Grid>
        <!-- Centered Modal Card -->
        <Border Width="740" MaxHeight="700" Background="{StaticResource CardBgBrush}" 
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" 
                CornerRadius="12" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Color="#000000" Opacity="0.7"/>
            </Border.Effect>
            <StackPanel>
                <!-- Header -->
                <DockPanel Margin="0,0,0,16">
                    <Border CornerRadius="10" Width="46" Height="46" Margin="0,0,14,0" Background="#161928" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <Image Source="pack://application:,,,/UncensoredStudio;component/Assets/Logo.png" RenderOptions.BitmapScalingMode="HighQuality" Margin="3"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Welcome to Uncensored Studio" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Set up your private local creative writing &amp; uncensored story engine" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </DockPanel>

                <!-- STEP 1: Choose Location & Select Model -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Section 1: Where to Download Models -->
                    <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="📁 1. WHERE TO STORE YOUR AI MODELS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="(Choose any drive with 10GB+ free space)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse Folder..." Style="{StaticResource SecondaryButton}" 
                                        Command="{Binding BrowseDirectoryCommand}" Margin="8,0,0,0" Padding="10,6"/>
                                <TextBox Text="{Binding ModelsDirectory, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" 
                                         Padding="8,6" FontSize="12" IsReadOnly="False"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Model Selection -->
                    <TextBlock Text="🧠 2. CHOOSE YOUR BASE UNALIGNED MODEL" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentRoseBrush}" Margin="0,0,0,8"/>

                    <ListBox ItemsSource="{Binding ModelCatalog}" SelectedItem="{Binding SelectedModelChoice}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12" Margin="0,0,0,8" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Border Background="#252940" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SizeDisplay}" FontSize="10" Foreground="{StaticResource AccentCyanBrush}"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding RecommendedFor}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentRoseBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <RadioButton Grid.Column="1" IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" 
                                                     VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Action Button -->
                    <Button Content="🚀 Start Download &amp; Initialize Studio" Style="{StaticResource SpicyButton}" 
                            Command="{Binding StartSetupProcessCommand}" Height="40" FontSize="14"/>
                </StackPanel>

                <!-- STEP 2: Downloading & Verifying -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,10,0,16">
                        <StackPanel HorizontalAlignment="Center" Width="600">
                            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                            <!-- Progress Bar -->
                            <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="12" Margin="0,0,0,10" Foreground="{StaticResource AccentRoseBrush}"/>

                            <TextBlock Text="{Binding DownloadProgress, StringFormat='{}{0:F1}% Completed'}" 
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                            <Button Content="Cancel Setup" Style="{StaticResource DangerButton}" Command="{Binding CancelSetupCommand}" HorizontalAlignment="Center" Padding="14,6"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- STEP 3: Setup Completed Successfully Screen -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,10,0,16">
                        <StackPanel HorizontalAlignment="Center" Width="600">
                            <Border Background="#064E3B" CornerRadius="30" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="✓" FontSize="32" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Setup Complete!" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            
                            <TextBlock Text="Your AI engine is connected and ready with full AMD GPU acceleration." 
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                            <!-- Active Model Badge -->
                            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Active Model: " FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding LoadedModelName}" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" FontSize="12"/>
                                    <TextBlock Text=" (Ready to Write)" Foreground="{StaticResource AccentGreenBrush}" FontSize="12" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Enter Studio Button -->
                            <Button Content="✨ Enter Studio &amp; Start Writing 🚀" Style="{StaticResource SpicyButton}" 
                                    Command="{Binding CompleteAndEnterStudioCommand}" Height="46" FontSize="15" Width="360"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
