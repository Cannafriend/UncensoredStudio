<UserControl x:Class="UncensoredStudio.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UncensoredStudio.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChatViewModel}"
             Background="{StaticResource BgDarkBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <!-- Sessions list -->
            <ColumnDefinition Width="*"/>
            <!-- Message thread -->
            <ColumnDefinition Width="300"/>
            <!-- Session memory & sampler settings inspector -->
        </Grid.ColumnDefinitions>

        <!-- Left: Isolated Chat Sessions List -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="CONVERSATIONS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <UniformGrid Columns="2">
                        <Button Content="+ AI Chat" Style="{StaticResource PrimaryButton}" Command="{Binding CreateNewSessionCommand}" FontSize="10" Padding="4,4" Margin="0,0,2,0" ToolTip="Start pure General AI / Coding chat"/>
                        <Button Content="+ Story RP" Style="{StaticResource SecondaryButton}" Command="{Binding CreateNewStorySessionCommand}" FontSize="10" Padding="4,4" Margin="2,0,0,0" ToolTip="Start creative fiction &amp; roleplay"/>
                    </UniformGrid>
                </StackPanel>

                <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentRoseBrush}" FontSize="10" DockPanel.Dock="Bottom" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Center: Chat Messages Thread -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Session Title Bar -->
                <RowDefinition Height="Auto"/>
                <!-- POV Perspective Quick Switcher Bar -->
                <RowDefinition Height="*"/>
                <!-- Scrollable Messages -->
                <RowDefinition Height="Auto"/>
                <!-- Input Box & Controls -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBox Text="{Binding SelectedSession.Title, UpdateSourceTrigger=PropertyChanged}" 
                         FontWeight="Bold" FontSize="18" Background="Transparent" BorderThickness="0" 
                         Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🧹 Clear" Style="{StaticResource SecondaryButton}" Command="{Binding ClearMessagesCommand}" Margin="0,0,6,0" FontSize="11" Padding="8,4"/>
                    <Button Content="🗑 Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteSessionCommand}" FontSize="11" Padding="8,4"/>
                </StackPanel>
            </DockPanel>

            <!-- Mid-Chat Perspective / POV Switcher Bar -->
            <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock Text="PERSPECTIVE:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentRoseBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <ComboBox ItemsSource="{Binding AvailablePerspectives}" SelectedItem="{Binding SelectedSession.Perspective, Mode=TwoWay}"
                              Width="180" Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" 
                              Padding="6,3" FontSize="11" Margin="0,0,12,0"/>

                    <TextBlock Text="POV FOCUS:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding AvailablePovCharacters}" SelectedItem="{Binding SelectedSession.PovCharacter, Mode=TwoWay}"
                              IsEditable="True" Width="170" Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" 
                              Padding="6,3" FontSize="11"/>
                </DockPanel>
            </Border>

            <!-- Messages List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="14,10" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="Background" Value="#1A1C30"/>
                                                <Setter Property="BorderBrush" Value="#3B3F68"/>
                                                <Setter Property="Margin" Value="40,0,0,12"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                                <Setter Property="Margin" Value="0,0,40,12"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <!-- Role Badge -->
                                    <TextBlock DockPanel.Dock="Top" FontSize="11" FontWeight="Bold" Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="🧠 FRONTIER AI ASSISTANT"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Text" Value="YOU"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentRoseBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Content -->
                                    <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" 
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                             TextWrapping="Wrap" FontFamily="Segoe UI, sans-serif"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bottom Input Bar -->
            <Border Grid.Row="3" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="8,0,0,0">
                        <Button Content="Send 🚀" Style="{StaticResource PrimaryButton}" Command="{Binding SendMessageCommand}" Margin="0,0,0,4"/>
                        <Button Content="🔄 Re-roll" Style="{StaticResource SecondaryButton}" Command="{Binding RegenerateLastResponseCommand}" FontSize="11" Margin="0,0,0,4"/>
                        <Button Content="⏹ Stop" Style="{StaticResource DangerButton}" Command="{Binding StopGenerationCommand}" 
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" FontSize="11"/>
                    </StackPanel>

                    <TextBox Text="{Binding InputMessage, UpdateSourceTrigger=PropertyChanged}" 
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                             ToolTip="Type your message, prompt, or story progression..."/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Right Panel: Session Inspector & Sampler Controls -->
        <Border Grid.Column="2" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,0,0" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="COGNITION &amp; MEMORY ENGINE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPurpleBrush}" Margin="0,0,0,8"/>

                    <!-- Cognition Presets (Claude, Deep Reasoning, Coder, Creative) -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="⚡ QUICK COGNITION PROFILES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentRoseBrush}" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Margin="0,0,0,4">
                                <Button Content="🧠 Claude / Gemini" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyCognitionPresetCommand}" CommandParameter="claude" FontSize="10" Padding="4,4" Margin="0,0,2,2" ToolTip="Frontier AI reasoning, code, truth-grounded"/>
                                <Button Content="🔬 Deep Reasoning" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyCognitionPresetCommand}" CommandParameter="reasoning" FontSize="10" Padding="4,4" Margin="2,0,0,2" ToolTip="Step-by-step verification, zero-hallucination"/>
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <Button Content="💻 Architect Coder" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyCognitionPresetCommand}" CommandParameter="coder" FontSize="10" Padding="4,4" Margin="0,0,2,0" ToolTip="Principal engineer, robust production code"/>
                                <Button Content="👑 Literary Smut" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyCognitionPresetCommand}" CommandParameter="creative" FontSize="10" Padding="4,4" Margin="2,0,0,0" ToolTip="Slow-burn literary romance &amp; erotica"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Persistent Working Memory Section -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="🧠 PERSISTENT WORKING MEMORY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PersistentMemories.Count, StringFormat='{}({0})'}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- Add Memory Input -->
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="+ Add" Style="{StaticResource PrimaryButton}" Command="{Binding AddPersistentMemoryCommand}" Padding="6,2" FontSize="10" Margin="4,0,0,0"/>
                                <TextBox Text="{Binding NewMemoryText, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10" Padding="4,2" ToolTip="Add a permanent fact, user rule, or project detail..."/>
                            </DockPanel>

                            <!-- Memory Facts List -->
                            <ItemsControl ItemsSource="{Binding PersistentMemories}" MaxHeight="130" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#121526" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                            <DockPanel>
                                                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" Command="{Binding DataContext.TogglePersistentMemoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Button DockPanel.Dock="Right" Content="×" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" Command="{Binding DataContext.DeletePersistentMemoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" FontSize="11" Padding="2,0"/>
                                                <TextBlock Text="{Binding Fact}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- System Prompt -->
                    <TextBlock Text="SYSTEM PROMPT (COGNITION)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SelectedSession.SystemPrompt, UpdateSourceTrigger=PropertyChanged}" 
                             Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" FontSize="11"/>

                    <!-- Author's Note -->
                    <TextBlock Text="AUTHOR'S NOTE (STYLE INJECTION)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SelectedSession.AuthorNote, UpdateSourceTrigger=PropertyChanged}" 
                             Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,4" FontSize="11"/>

                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Injection Depth:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SelectedSession.AuthorNoteDepth, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Right" FontSize="11"/>
                    </DockPanel>

                    <!-- Sampler Settings -->
                    <TextBlock Text="UNCENSORED SAMPLER CONTROLS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Temperature:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBox Text="{Binding SelectedSession.Temperature, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Right" FontSize="11"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Min-P (Prose Focus):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBox Text="{Binding SelectedSession.MinP, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Right" FontSize="11"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="DRY Repetition Pen:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBox Text="{Binding SelectedSession.DryMultiplier, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Right" FontSize="11"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Max Tokens:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBox Text="{Binding SelectedSession.MaxTokens, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Right" FontSize="11"/>
                    </DockPanel>

                    <Button Content="💾 Save Session Settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSessionSettingsCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
