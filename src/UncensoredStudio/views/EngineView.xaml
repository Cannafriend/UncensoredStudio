<UserControl x:Class="UncensoredStudio.Views.EngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UncensoredStudio.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EngineViewModel}"
             Background="{StaticResource BgDarkBrush}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <!-- Models Catalog & Directory Config -->
            <ColumnDefinition Width="*"/>
            <!-- Engine Status & Backend Console -->
        </Grid.ColumnDefinitions>

        <!-- Left: Model Catalog & Management -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel>
                <!-- Storage Folder Config -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📁 MODEL STORAGE FOLDER" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPurpleBrush}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseModelsDirectoryCommand}" Margin="8,0,0,0" Padding="10,4" FontSize="11"/>
                            <TextBox Text="{Binding Settings.ModelsDirectory, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="6,4" FontSize="11"/>
                        </DockPanel>
                        <DockPanel>
                            <Button Content="🔄 Rescan Folder" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshLocalModelsCommand}" FontSize="11" Padding="8,4"/>
                            <Button Content="📂 Open Folder in Explorer" Style="{StaticResource SecondaryButton}" Command="{Binding OpenModelsFolderCommand}" HorizontalAlignment="Right" FontSize="11" Padding="8,4"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Model Catalog (Install Additional Models) -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🧠 MODEL HUB &amp; INSTALLER" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentRoseBrush}" Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding ModelCatalog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <!-- Top Line: Name, Tag, Size, and Buttons -->
                                            <DockPanel Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Border Background="#252940" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding SizeDisplay}" FontSize="10" Foreground="{StaticResource AccentCyanBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Installed / Action Button -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="⚡ Switch To" Style="{StaticResource PrimaryButton}" 
                                                            Command="{Binding DataContext.SwitchModelDirectlyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding LocalPath}"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                                                            FontSize="11" Padding="8,4" Margin="0,0,4,0"/>
                                                    <Button Content="⬇️ Install" Style="{StaticResource SpicyButton}" 
                                                            Command="{Binding DataContext.InstallCatalogModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}"
                                                            FontSize="11" Padding="8,4"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Category & Tier -->
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="{Binding RecommendedFor}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentRoseBrush}"/>
                                            </DockPanel>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <!-- Hardware Compatibility Diagnostic Badge -->
                                            <Border Background="#121526" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareStatus}" FontWeight="Bold" FontSize="10" Foreground="{Binding HardwareStatusColor}"/>
                                                    <TextBlock Text="{Binding HardwareStatusDetails}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Custom HuggingFace GGUF Download -->
                        <TextBlock Text="INSTALL CUSTOM HUGGINGFACE GGUF" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,4"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Download URL" Style="{StaticResource SecondaryButton}" Command="{Binding DownloadCustomModelCommand}" Margin="8,0,0,0" FontSize="11" Padding="10,4"/>
                            <TextBox Text="{Binding CustomDownloadUrl, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="6,4" FontSize="11" ToolTip="Paste HuggingFace direct GGUF download link..."/>
                        </DockPanel>

                        <!-- Progress Bar -->
                        <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="8" Margin="0,0,0,4" Foreground="{StaticResource AccentRoseBrush}"/>
                        <TextBlock Text="{Binding DownloadStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: Engine Controls & Live Console -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Engine Control Card -->
                <RowDefinition Height="*"/>
                <!-- Backend Console Log -->
            </Grid.RowDefinitions>

            <!-- Engine Controls Card -->
            <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="KOBOLDCPP VULKAN ENGINE (AMD RX 6700 XT)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center"/>
                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#3B1219"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsApiOnline}" Value="True">
                                            <Setter Property="Background" Value="#064E3B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ActiveModelName, StringFormat='{}Connected: {0}'}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </DockPanel>

                    <!-- Active Local Model Selector -->
                    <TextBlock Text="LOADED LOCAL MODEL FILE (.GGUF)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableLocalModels}" SelectedItem="{Binding SelectedLocalModel}"
                              DisplayMemberPath="DisplayName"
                              Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="8,6" Margin="0,0,0,10"/>

                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="▶ Start / Reload Backend" Style="{StaticResource PrimaryButton}" Command="{Binding StartBackendCommand}" Margin="0,0,4,0"/>
                        <Button Content="⏹ Stop Backend" Style="{StaticResource DangerButton}" Command="{Binding StopBackendCommand}" Margin="4,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Console Log -->
            <Border Grid.Row="1" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LIVE ENGINE OUTPUT CONSOLE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding ConsoleLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource InputBgBrush}" Foreground="{StaticResource AccentCyanBrush}" 
                             FontFamily="Consolas, monospace" FontSize="11" BorderThickness="0" Padding="8"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
