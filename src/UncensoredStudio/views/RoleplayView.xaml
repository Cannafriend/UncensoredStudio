<UserControl x:Class="UncensoredStudio.Views.RoleplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UncensoredStudio.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RoleplayViewModel}"
             Background="{StaticResource BgDarkBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <!-- RP Scenes List -->
            <ColumnDefinition Width="*"/>
            <!-- Roleplay Stage & Dialogue Flow -->
            <ColumnDefinition Width="320"/>
            <!-- Cast Roster & Scene Director Panel -->
        </Grid.ColumnDefinitions>

        <!-- Left: RP Scenes List -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="🎭 ROLEPLAY SCENES" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentRoseBrush}" Margin="0,0,0,6"/>
                    <Button Content="+ New RP Scene" Style="{StaticResource SpicyButton}" Command="{Binding CreateNewSceneCommand}" FontSize="11" Padding="8,6" ToolTip="Create a new multi-character roleplay scene"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock Text="{Binding Perspective}" Foreground="{StaticResource AccentPurpleBrush}" FontSize="9" DockPanel.Dock="Bottom" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Center: Roleplay Stage & Dialogue Flow -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Scene Mood & Cast Banner -->
                <RowDefinition Height="*"/>
                <!-- Message turns flow -->
                <RowDefinition Height="Auto"/>
                <!-- Auto-Play / Typing Indicator -->
                <RowDefinition Height="Auto"/>
                <!-- Input Controls & Actions -->
            </Grid.RowDefinitions>

            <!-- Scene Title Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBox Text="{Binding SelectedSession.Title, UpdateSourceTrigger=PropertyChanged}" 
                         FontWeight="Bold" FontSize="18" Background="Transparent" BorderThickness="0" 
                         Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🧹 Clear" Style="{StaticResource SecondaryButton}" Command="{Binding ClearSceneMessagesCommand}" Margin="0,0,6,0" FontSize="11" Padding="8,4"/>
                    <Button Content="🗑 Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteSceneCommand}" FontSize="11" Padding="8,4"/>
                </StackPanel>
            </DockPanel>

            <!-- Scene Mood & Active Cast Banner -->
            <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="▶️ Next Turn" Style="{StaticResource PrimaryButton}" Command="{Binding AdvanceNextTurnCommand}" FontSize="11" Padding="8,3" Margin="0,0,6,0" ToolTip="Let the AI select the next character to speak/act"/>
                        <Button Content="⚡ Auto (3x)" Style="{StaticResource SecondaryButton}" Command="{Binding StartAutoPlayCommand}" CommandParameter="3" FontSize="11" Padding="8,3" Margin="0,0,6,0" ToolTip="Run 3 back-and-forth turns automatically"/>
                        <Button Content="♾️ Play Until Stopped" Style="{StaticResource SpicyButton}" Command="{Binding StartContinuousAutoPlayCommand}" FontSize="11" Padding="8,3" ToolTip="Plays continuously back and forth until you hit Stop"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎭 CAST:" FontWeight="Bold" FontSize="10" Foreground="{StaticResource AccentRoseBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ItemsControl ItemsSource="{Binding ActiveCast}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}" 
                                            Background="#1E1B2E" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1" 
                                            CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Scrollable Roleplay Turns Flow -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="14,10" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="Background" Value="#1A1829"/>
                                                <Setter Property="BorderBrush" Value="#4C2860"/>
                                                <Setter Property="Margin" Value="30,0,0,12"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                                <Setter Property="Margin" Value="0,0,30,12"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <!-- Turn Role Badge -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="🎭 CHARACTER DIALOGUE &amp; ACTION"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRoseBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                            <Setter Property="Text" Value="👤 USER INTERVENTION / DIRECTOR"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <!-- Content -->
                                    <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" 
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                             TextWrapping="Wrap" FontFamily="Segoe UI, sans-serif"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Auto-Play / Generation Indicator Bubble -->
            <Border Grid.Row="3" Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" 
                    Background="#181B2B" BorderBrush="{StaticResource AccentRoseBrush}" BorderThickness="1" 
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="40" Height="4" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource AccentRoseBrush}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="⏹ Stop" Style="{StaticResource DangerButton}" Command="{Binding StopAutoPlayCommand}" FontSize="10" Padding="8,3" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Bottom Input & Roleplay Actions Bar -->
            <Border Grid.Row="4" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <StackPanel>
                    <!-- Action Bar: Speak As & Quick Turn Triggers -->
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Speak As:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding SpeakerOptions}" SelectedItem="{Binding SelectedSpeaker}"
                                      Width="190" Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" 
                                      Padding="6,3" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 Re-roll" Style="{StaticResource SecondaryButton}" Command="{Binding RegenerateLastTurnCommand}" FontSize="10" Padding="8,4" Margin="0,0,6,0" ToolTip="Re-roll the last response"/>
                            <Button Content="▶️ Next Turn" Style="{StaticResource PrimaryButton}" Command="{Binding AdvanceNextTurnCommand}" FontSize="10" Padding="10,4" Margin="0,0,6,0" ToolTip="Advance 1 character turn"/>
                            <Button Content="⚡ Auto (3x)" Style="{StaticResource SecondaryButton}" Command="{Binding StartAutoPlayCommand}" CommandParameter="3" FontSize="10" Padding="10,4" Margin="0,0,6,0" ToolTip="Run 3 turns"/>
                            <Button Content="♾️ Play Until Stopped" Style="{StaticResource SpicyButton}" Command="{Binding StartContinuousAutoPlayCommand}" FontSize="10" Padding="10,4" ToolTip="Characters play back and forth continuously until you click Stop"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Text Input Box & Send -->
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Send 🚀" Style="{StaticResource PrimaryButton}" Command="{Binding SendTurnCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="14,10"/>
                        <TextBox Text="{Binding InputMessage, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                 ToolTip="Type dialogue, character actions, or [Director Event: A violent thunderclap rocks the building]..."/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Right: Cast Roster & Scene Director Panel -->
        <Border Grid.Column="2" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,0,0" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Cast Management Header -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="🎭 ACTIVE SCENE CAST" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentRoseBrush}" VerticalAlignment="Center"/>
                        <Button Content="+ New Cast Member" Style="{StaticResource SecondaryButton}" Command="{Binding OpenAddCharacterModalCommand}" FontSize="10" Padding="6,2" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Cast Roster Items -->
                    <ItemsControl ItemsSource="{Binding ActiveCast}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <DockPanel>
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding AgeRole}" FontSize="10" Foreground="{StaticResource AccentPurpleBrush}" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Personality}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Scenario Setting -->
                    <TextBlock Text="🗺️ SCENE SETTING &amp; PREMISE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ScenarioSetting, UpdateSourceTrigger=PropertyChanged}" 
                             Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" FontSize="11"
                             ToolTip="Describe the environment, situation, and opening context for this scene..."/>

                    <!-- Scene Mood / Dynamic -->
                    <TextBlock Text="🔥 SCENE DYNAMIC &amp; MOOD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableMoods}" SelectedItem="{Binding DynamicMood, Mode=TwoWay}"
                              Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" 
                              Padding="6,4" FontSize="11" Margin="0,0,0,12"/>

                    <!-- Sampler Settings -->
                    <TextBlock Text="⚙️ ROLEPLAY SAMPLER SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Temperature (Creativity):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBox Text="{Binding SelectedSession.Temperature, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Right" FontSize="11"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Min-P (Dialogue Focus):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBox Text="{Binding SelectedSession.MinP, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Right" FontSize="11"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="DRY Repetition Pen:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBox Text="{Binding SelectedSession.DryMultiplier, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Right" FontSize="11"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Max Tokens / Turn:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBox Text="{Binding SelectedSession.MaxTokens, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Right" FontSize="11"/>
                    </DockPanel>

                    <Button Content="💾 Save Scene Configuration" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSceneSettingsCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Quick Add Character Modal Overlay -->
        <Grid Grid.ColumnSpan="3" Background="#AA000000" Visibility="{Binding ShowAddCharModal, Converter={StaticResource BoolToVis}}">
            <Border Width="450" Background="#161828" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="🎭 ADD NEW CHARACTER" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Button Content="✕" Style="{StaticResource SecondaryButton}" Command="{Binding CloseAddCharacterModalCommand}" Padding="6,2" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <TextBlock Text="Character Name:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCharName, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Margin="0,0,0,10"/>

                    <TextBlock Text="Role / Archetype (e.g. 28, Undercover Detective):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCharRole, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Margin="0,0,0,10"/>

                    <TextBlock Text="Personality &amp; Mindset:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCharPersonality, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12" Margin="0,0,0,10"/>

                    <TextBlock Text="Dialogue Voice &amp; Cadence:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCharDialogue, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Margin="0,0,0,16"/>

                    <UniformGrid Columns="2">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CloseAddCharacterModalCommand}" Margin="0,0,6,0"/>
                        <Button Content="Save Character" Style="{StaticResource PrimaryButton}" Command="{Binding SaveNewCharacterCommand}" Margin="6,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
