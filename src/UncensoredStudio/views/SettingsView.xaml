<UserControl x:Class="UncensoredStudio.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UncensoredStudio.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Background="{StaticResource BgDarkBrush}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480"/>
            <!-- Typography & Google Fonts Section -->
            <ColumnDefinition Width="*"/>
            <!-- Memory Management & Hardware Engine Suite -->
        </Grid.ColumnDefinitions>

        <!-- Left Column: Typography & Google Fonts -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel>
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="🎨 SYSTEM TYPOGRAPHY &amp; GOOGLE FONTS" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="Select a font to instantly update the entire application interface:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                        <!-- Font Selection List -->
                        <ListBox ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedFont}"
                                 Background="Transparent" BorderThickness="0" Margin="0,0,0,14">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <DockPanel Margin="0,0,0,2">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Border Background="#252940" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="9" Foreground="{StaticResource AccentCyanBrush}"/>
                                                    </Border>
                                                </DockPanel>
                                                <!-- Font Sample Preview Rendered with the exact font -->
                                                <TextBlock Text="{Binding PreviewText}" FontFamily="{Binding FontFamilyValue}" 
                                                           FontSize="12" Foreground="{StaticResource AccentRoseBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <RadioButton Grid.Column="1" IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" 
                                                         VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Active Font Live Test Box -->
                        <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="ACTIVE FONT LIVE PREVIEW:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="The rain against the penthouse glass was relentless. Chaos stepped forward, his eyes holding an electric, unspoken promise." 
                                           FontFamily="{Binding SelectedFont.FontFamilyValue}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Column: Memory Management & Hardware Engine -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Memory Management Suite -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🧠 MEMORY PURGE &amp; ISOLATION SUITE" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentRoseBrush}" Margin="0,0,0,12"/>

                        <!-- Clear Memory Per Story -->
                        <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📖 CLEAR MEMORY PER STORY" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Purge chapters, character profiles, and memory for a specific story novel without affecting others:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="🗑 Clear Selected Story" Style="{StaticResource DangerButton}" Command="{Binding ClearStoryMemoryCommand}" Margin="8,0,0,0" Padding="12,6"/>
                                    <ComboBox ItemsSource="{Binding AvailableProjects}" SelectedItem="{Binding SelectedProjectToClear}" DisplayMemberPath="Title"
                                              Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="8,6" FontSize="11"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Clear All Chat History -->
                        <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Clear All Chats" Style="{StaticResource DangerButton}" Command="{Binding ClearAllChatHistoryCommand}" Padding="12,6"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="💬 CLEAR ALL CHAT CONVERSATIONS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Wipe chat message history across all sessions (Characters and novels stay intact)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Clear Lore & Characters -->
                        <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Clear Lore &amp; Characters" Style="{StaticResource DangerButton}" Command="{Binding ClearAllLoreAndCharactersCommand}" Padding="12,6"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="📚 CLEAR ALL LOREBOOKS &amp; CHARACTERS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Delete all custom characters, kinks, and world lore entries" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Master Clear Entire Studio -->
                        <Border Background="#2B0D12" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="14">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="⚠️ PURGE ENTIRE MEMORY" Style="{StaticResource DangerButton}" Command="{Binding ClearAllMemoryCommand}" Padding="14,8" FontWeight="Bold"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🔥 MASTER RESET: PURGE ALL STUDIO DATA" FontWeight="Bold" FontSize="12" Foreground="#F87171"/>
                                    <TextBlock Text="Permanently wipes all stories, chats, characters, drafts, and lorebooks" FontSize="10" Foreground="#FCA5A5"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Hardware & Engine Config -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="⚡ HARDWARE &amp; CONTEXT ACCELERATION" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentPurpleBrush}" Margin="0,0,0,10"/>

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="GPU Layers (Vulkan AMD RX 6700 XT):" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Settings.GpuLayers, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Context Window Tokens:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Settings.ContextSize, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="11"/>
                            </StackPanel>
                        </UniformGrid>

                        <DockPanel>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentGreenBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="💾 Save Hardware Config" Style="{StaticResource PrimaryButton}" Command="{Binding SaveHardwareSettingsCommand}" HorizontalAlignment="Right" Padding="10,6" FontSize="11"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
