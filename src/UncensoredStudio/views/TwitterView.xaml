<UserControl x:Class="UncensoredStudio.Views.TwitterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UncensoredStudio.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TwitterViewModel}"
             Background="{StaticResource BgDarkBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <!-- Saved Drafts Sidebar -->
            <ColumnDefinition Width="380"/>
            <!-- Generator Control Panel -->
            <ColumnDefinition Width="*"/>
            <!-- Interactive Tweet Cards Preview & Thread Editor -->
        </Grid.ColumnDefinitions>

        <!-- Left: Saved Drafts -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="SAVED POSTS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <Button Content="🗑 Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteDraftCommand}" HorizontalAlignment="Right" FontSize="11" Padding="6,2"/>
                </DockPanel>

                <ListBox ItemsSource="{Binding Drafts}" SelectedItem="{Binding SelectedDraft}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentRoseBrush}" FontSize="10" DockPanel.Dock="Bottom" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Center: Generator Settings & Prompt Input -->
        <Border Grid.Column="1" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="SPICY SOCIAL STUDIO" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentRoseBrush}" Margin="0,0,0,12"/>

                    <!-- Mode Selector -->
                    <TextBlock Text="POST TYPE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedMode}"
                              Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="8,6" Margin="0,0,0,10"/>

                    <!-- Tone Selector -->
                    <TextBlock Text="TONE &amp; FLAVOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableTones}" SelectedItem="{Binding SelectedTone}"
                              Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="8,6" Margin="0,0,0,12"/>

                    <!-- Prompt / Excerpt Input -->
                    <TextBlock Text="TOPIC, SCENE EXCERPT, OR IDEA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding InputPrompt, UpdateSourceTrigger=PropertyChanged}" 
                             Height="160" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                             ToolTip="Paste a scene excerpt from your novel or type a spicy theme/prompt..."/>

                    <!-- Action Buttons -->
                    <Button Content="🔥 Generate Spicy Content" Style="{StaticResource SpicyButton}" Command="{Binding GeneratePostsCommand}" Margin="0,0,0,8"/>

                    <Button Content="⏹ Stop Generating" Style="{StaticResource DangerButton}" Command="{Binding StopGenerationCommand}" 
                            Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right: Tweet Thread Cards & Live 280-char counter -->
        <Grid Grid.Column="2" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Thread Header & Quick Actions -->
                <RowDefinition Height="*"/>
                <!-- Tweet Cards List -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="GENERATED TWEET CARDS" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📋 Copy Complete Thread" Style="{StaticResource PrimaryButton}" Command="{Binding CopyFullThreadCommand}" Margin="0,0,8,0" FontSize="12"/>
                    <Button Content="💾 Save to Library" Style="{StaticResource SecondaryButton}" Command="{Binding SaveDraftCommand}" FontSize="12"/>
                </StackPanel>
            </DockPanel>

            <!-- Cards List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TweetCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <DockPanel>
                                    <!-- Card Header -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Index, StringFormat='{}Tweet #{0}'}" FontWeight="Bold" Foreground="{StaticResource AccentRoseBrush}" VerticalAlignment="Center"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <!-- Character count badge -->
                                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1E293B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                                                                <Setter Property="Background" Value="#7F1D1D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding CharCount, StringFormat='{}{0}/280 chars'}" FontSize="11" Foreground="White"/>
                                            </Border>

                                            <Button Content="📋 Copy" Style="{StaticResource SecondaryButton}" 
                                                    Command="{Binding DataContext.CopyTweetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" FontSize="11" Padding="6,2"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Editable Tweet Body -->
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" 
                                             AcceptsReturn="True" TextWrapping="Wrap" Background="{StaticResource InputBgBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                             BorderBrush="{StaticResource InputBorderBrush}" Padding="8" MinHeight="70"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
