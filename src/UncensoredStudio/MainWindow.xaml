<Window x:Class="UncensoredStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:UncensoredStudio.Views"
        xmlns:vm="clr-namespace:UncensoredStudio.ViewModels"
        mc:Ignorable="d"
        Title="Uncensored Writing Studio - Professional Creative &amp; Social Suite" 
        Height="880" Width="1400" MinHeight="650" MinWidth="1050"
        Background="{StaticResource BgDarkBrush}"
        FontFamily="{Binding AppFontFamily}"
        Icon="pack://application:,,,/UncensoredStudio;component/Assets/app.ico"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">

    <!-- Modern Custom WindowChrome (Removes default white title bar) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Dynamic View Routing DataTemplates -->
        <DataTemplate DataType="{x:Type vm:NovelViewModel}">
            <views:NovelView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoleplayViewModel}">
            <views:RoleplayView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TwitterViewModel}">
            <views:TwitterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LorebookViewModel}">
            <views:LorebookView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImageStudioViewModel}">
            <views:ImageStudioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EngineViewModel}">
            <views:EngineView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <!-- Custom Window Control Button Styles -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252940"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E11D48"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Top Header & Navigation Bar -->
            <RowDefinition Height="*"/>
            <!-- Main Content Area -->
            <RowDefinition Height="36"/>
            <!-- Bottom Status & Quick Settings Bar -->
        </Grid.RowDefinitions>

        <!-- Custom Top Header Bar (Draggable window area with embedded controls) -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="14,0,8,0">
            <DockPanel VerticalAlignment="Center">
                <!-- Branding & Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" Background="#161928" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <Image Source="pack://application:,,,/UncensoredStudio;component/Assets/Logo.png" RenderOptions.BitmapScalingMode="HighQuality" Margin="3"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="UNCENSORED STUDIO" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Uncensored Fiction &amp; Social Engine" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Window Control Buttons & System Indicators at Far Right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Quick Model Switcher Dropdown -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="Model:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding HeaderModelsList}" SelectedItem="{Binding SelectedHeaderModel}"
                                  DisplayMemberPath="DisplayName"
                                  Width="220" Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" 
                                  Padding="6,4" FontSize="11" ToolTip="Quick Switch Active Model"/>
                    </StackPanel>

                    <!-- Model Hub Button -->
                    <Button Content="⚡ Model Hub" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding SwitchTabCommand}" CommandParameter="Engine"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            FontSize="11" Padding="8,4" Margin="0,0,8,0"/>

                    <!-- Connection Status Badge -->
                    <Border CornerRadius="12" Padding="8,3" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Background="{StaticResource CardBgBrush}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBackendConnected}" Value="True">
                                                <Setter Property="Fill" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ActiveModelSummary}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Window Control Buttons (Minimize, Maximize, Close) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="🗕" Style="{StaticResource WindowControlBtn}" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                        <Button Content="🗖" Style="{StaticResource WindowControlBtn}" Click="MaximizeButton_Click" ToolTip="Maximize / Restore"/>
                        <Button Content="✕" Style="{StaticResource WindowCloseBtn}" Click="CloseButton_Click" ToolTip="Close"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton Content="📖 Story Studio" 
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Novel" Margin="0,0,6,0">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource NavTabButton}">
                                <Setter Property="IsChecked" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Novel">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton Content="💬 General AI &amp; Chat" 
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Chat" Margin="0,0,6,0">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource NavTabButton}">
                                <Setter Property="IsChecked" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Chat">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton Content="🐦 X / Twitter Smut &amp; Teasers" 
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Twitter" Margin="0,0,6,0">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource NavTabButton}">
                                <Setter Property="IsChecked" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Twitter">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton Content="📚 Lorebook &amp; World Bible" 
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Lorebook" Margin="0,0,6,0">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource NavTabButton}">
                                <Setter Property="IsChecked" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Lorebook">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton Content="⚙️ Model Hub &amp; Engine" 
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Engine">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource NavTabButton}">
                                <Setter Property="IsChecked" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Engine">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Dynamic View Container (Always Visible & Active) -->
        <Grid Grid.Row="1">
            <!-- Active Dynamic Workspace (Novel, Chat, Twitter, Lorebook, Engine, Settings) -->
            <ContentControl Content="{Binding CurrentViewModel}"/>

            <!-- Startup Model Selector Modal Overlay -->
            <Grid Visibility="{Binding ShowStartupModelPicker, Converter={StaticResource BoolToVis}}">
                <views:StartupModelPickerView/>
            </Grid>

            <!-- First Run Setup Wizard Overlay Modal (If No Models Downloaded) -->
            <Grid Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
                <views:SetupWizardView DataContext="{Binding SetupWizardVm}"/>
            </Grid>
        </Grid>

        <!-- Bottom Bar: Settings Button at Bottom-Left & System Diagnostics -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <!-- Settings Button at Bottom-Left -->
                <Button Content="⚙️ Studio Settings &amp; Memory" Style="{StaticResource SecondaryButton}" 
                        Command="{Binding OpenSettingsCommand}" 
                        Padding="10,4" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center"/>

                <!-- Switch to Settings Active State indicator -->
                <TextBlock Text="Private &amp; Local Offline Inference" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>

                <!-- Right System Status -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="AMD Vulkan Accelerated (RX 6700 XT 12GB)" FontSize="10" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="SQLite Zero-Leak Storage" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
