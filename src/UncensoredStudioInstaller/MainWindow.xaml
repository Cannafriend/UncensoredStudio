<Window x:Class="UncensoredStudioInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uncensored Studio - Setup"
        Height="600" Width="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/Assets/app.ico">

    <!-- Outer Glow & Rounded Obsidian Card -->
    <Border CornerRadius="14" Background="#0A0C14" BorderBrush="#252A42" BorderThickness="1.5" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Color="#7C3AED" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- Header / Titlebar -->
                <RowDefinition Height="*"/>
                <!-- Main Content Steps -->
            </Grid.RowDefinitions>

            <!-- Custom Draggable Header Bar -->
            <Border Grid.Row="0" Background="#0F121E" CornerRadius="14,14,0,0" BorderBrush="#1F243A" BorderThickness="0,0,0,1" 
                    MouseDown="Header_MouseDown" Padding="16,0,10,0">
                <DockPanel VerticalAlignment="Center">
                    <!-- Window Controls (Right) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="🗕" Click="Minimize_Click" Width="36" Height="30" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                        <Button Content="✕" Click="Close_Click" Width="36" Height="30" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                    </StackPanel>

                    <!-- Branding (Left) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0" Background="#161A2B" BorderBrush="#2F3654" BorderThickness="1">
                            <Image Source="pack://application:,,,/Assets/Logo.png" RenderOptions.BitmapScalingMode="HighQuality" Margin="3"/>
                        </Border>
                        <TextBlock Text="UNCENSORED STUDIO" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Border Background="#252B44" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="OFFICIAL SETUP v1.0.0" FontSize="10" Foreground="#A855F7" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="24,18,24,20">
                
                <!-- ============================================================ -->
                <!-- STEP 1: WELCOME & HARDWARE / SYSTEM REQUIREMENTS             -->
                <!-- ============================================================ -->
                <Grid x:Name="Step1_Hardware" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Hero Card -->
                    <Border Grid.Column="0" Background="#111422" CornerRadius="10" BorderBrush="#222840" BorderThickness="1" Padding="18" Margin="0,0,18,0">
                        <DockPanel>
                            <!-- Top Logo & Titles -->
                            <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,4,0,14">
                                <Border CornerRadius="12" Width="68" Height="68" Margin="0,0,0,10" Background="#181D30" BorderBrush="#3B2658" BorderThickness="1.5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Color="#E11D48" Opacity="0.4"/>
                                    </Border.Effect>
                                    <Image Source="pack://application:,,,/Assets/Logo.png" RenderOptions.BitmapScalingMode="HighQuality" Margin="6"/>
                                </Border>
                                <TextBlock Text="Uncensored Studio" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                                <TextBlock Text="Private Fiction &amp; Social Suite" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Feature List -->
                            <StackPanel VerticalAlignment="Center">
                                <Border Background="#181D30" CornerRadius="6" Padding="10,6" Margin="0,0,0,7">
                                    <TextBlock Text="🔒 100% Private Offline Inference" FontSize="11" Foreground="#CBD5E1"/>
                                </Border>
                                <Border Background="#181D30" CornerRadius="6" Padding="10,6" Margin="0,0,0,7">
                                    <TextBlock Text="⚡ AMD Vulkan GPU Acceleration" FontSize="11" Foreground="#06B6D4"/>
                                </Border>
                                <Border Background="#181D30" CornerRadius="6" Padding="10,6" Margin="0,0,0,7">
                                    <TextBlock Text="🧠 Magnum 12B &amp; Stheno 8B" FontSize="11" Foreground="#A855F7"/>
                                </Border>
                                <Border Background="#181D30" CornerRadius="6" Padding="10,6">
                                    <TextBlock Text="💾 Zero-Leak Encrypted Storage" FontSize="11" Foreground="#10B981"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Right Hardware Diagnostic & Specs -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="HARDWARE DIAGNOSTIC &amp; SYSTEM REQUIREMENTS" FontSize="11" FontWeight="Bold" Foreground="#A855F7" Margin="0,0,0,10"/>

                        <!-- Live Detected Hardware Card -->
                        <Border Background="#121626" CornerRadius="8" BorderBrush="#252C48" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🖥️ YOUR SYSTEM HARDWARE DETECTED" FontWeight="Bold" FontSize="10" Foreground="#38BDF8" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtDetectedGpu" Text="⚡ GPU: Scanning graphics accelerator..." FontSize="11" Foreground="#F8FAFC" Margin="0,0,0,3"/>
                                <TextBlock x:Name="TxtDetectedRam" Text="🧠 RAM: Calculating system memory..." FontSize="11" Foreground="#F8FAFC" Margin="0,0,0,3"/>
                                <TextBlock x:Name="TxtDetectedOs" Text="💻 OS: Windows 11 64-bit (Fully Compatible)" FontSize="11" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>

                        <!-- Minimum vs Recommended Table -->
                        <Border Background="#111422" CornerRadius="8" BorderBrush="#20253A" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Minimum Specs -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="MINIMUM SPECS" FontWeight="Bold" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <TextBlock Text="• GPU: 6GB+ VRAM (Vulkan / CUDA)" FontSize="10" Foreground="#CBD5E1" Margin="0,0,0,3"/>
                                    <TextBlock Text="• RAM: 16 GB System Memory" FontSize="10" Foreground="#CBD5E1" Margin="0,0,0,3"/>
                                    <TextBlock Text="• CPU: 6-Core Modern Processor" FontSize="10" Foreground="#CBD5E1" Margin="0,0,0,3"/>
                                    <TextBlock Text="• Disk: 2 GB (+ 8 GB for models)" FontSize="10" Foreground="#CBD5E1"/>
                                </StackPanel>

                                <!-- Recommended Specs -->
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="RECOMMENDED SPECS" FontWeight="Bold" FontSize="10" Foreground="#10B981" Margin="0,0,0,6"/>
                                    <TextBlock Text="• GPU: 12GB+ VRAM (RX 6700 XT / RTX 3060+)" FontSize="10" Foreground="#F8FAFC" Margin="0,0,0,3"/>
                                    <TextBlock Text="• RAM: 32 GB+ for 12B/14B models" FontSize="10" Foreground="#F8FAFC" Margin="0,0,0,3"/>
                                    <TextBlock Text="• CPU: 8-Core AMD Ryzen / Intel i7" FontSize="10" Foreground="#F8FAFC" Margin="0,0,0,3"/>
                                    <TextBlock Text="• Disk: NVMe SSD for fast model loading" FontSize="10" Foreground="#F8FAFC"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Next Step Button -->
                        <Button Content="Continue to Terms &amp; Privacy Policy →" Style="{StaticResource SpicyButton}" Click="GoToStep2_Click" Height="42" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- ============================================================ -->
                <!-- STEP 2: TERMS OF SERVICE, PRIVACY POLICY & DISCLAIMER        -->
                <!-- ============================================================ -->
                <Grid x:Name="Step2_Eula" Visibility="Collapsed">
                    <DockPanel>
                        <!-- Header -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="TERMS OF SERVICE &amp; PRIVACY POLICY" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="Please review the offline privacy terms and creative writing agreement before proceeding." FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>

                        <!-- Bottom Agreement Checkbox & Navigation -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Border Background="#161A2B" CornerRadius="6" BorderBrush="#2C324C" BorderThickness="1" Padding="12,8" Margin="0,0,0,12">
                                <CheckBox x:Name="ChkAcceptEula" Checked="ChkAcceptEula_Changed" Unchecked="ChkAcceptEula_Changed"
                                          Content="I am 18+ years of age and accept the Terms of Service and 100% Offline Privacy Policy" 
                                          Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12"/>
                            </Border>

                            <DockPanel>
                                <Button Content="← Back" Style="{StaticResource SecondaryButton}" Click="BackToStep1_Click" DockPanel.Dock="Left" Padding="16,8" Width="90"/>
                                <Button x:Name="BtnContinueToSettings" Content="Continue to Install Settings →" Style="{StaticResource SpicyButton}" 
                                        Click="GoToStep3_Click" Height="40" FontSize="13" IsEnabled="False"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- Scrollable EULA / Privacy Document Box -->
                        <Border Background="#101320" CornerRadius="8" BorderBrush="#20253A" BorderThickness="1" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="11" LineHeight="17">
                                    <Bold Foreground="#A855F7">1. 100% ZERO-TELEMETRY &amp; LOCAL PRIVACY GUARANTEE</Bold><LineBreak/>
                                    Uncensored Studio is engineered from the ground up for absolute user privacy and local sovereignty.
                                    • Zero telemetry, tracking, analytics, or behavioral data collection.<LineBreak/>
                                    • All AI language model execution runs 100% locally on your own computer hardware.<LineBreak/>
                                    • Your manuscripts, character profiles, story prompts, and generated text are stored locally in your SQLite database and are never transmitted over the internet to cloud servers or third parties.<LineBreak/><LineBreak/>

                                    <Bold Foreground="#E11D48">2. UNCENSORED MATURE FICTION &amp; CREATIVE SOVEREIGNTY (18+)</Bold><LineBreak/>
                                    Uncensored Studio provides unaligned local language models for mature novel authors, fiction writers, and world-builders.
                                    • You own 100% of the intellectual property, copyrights, and commercial rights to all text, stories, and manuscripts created with this application.<LineBreak/>
                                    • You acknowledge that the software contains adult fiction themes and agree to use the local generation tools responsibly and in compliance with applicable local laws.<LineBreak/><LineBreak/>

                                    <Bold Foreground="#06B6D4">3. HARDWARE ACCELERATION &amp; LOCAL COMPUTING</Bold><LineBreak/>
                                    The software utilizes automated Vulkan and DirectML hardware offloading to maximize tokens-per-second on AMD Radeon, NVIDIA GeForce, Intel Arc, and multi-threaded CPUs. Performance depends entirely on your local hardware specifications.
                                </TextBlock>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- ============================================================ -->
                <!-- STEP 3: INSTALLATION DIRECTORY & SHORTCUTS                   -->
                <!-- ============================================================ -->
                <Grid x:Name="Step3_Config" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Summary Card -->
                    <Border Grid.Column="0" Background="#111422" CornerRadius="10" BorderBrush="#222840" BorderThickness="1" Padding="18" Margin="0,0,18,0">
                        <StackPanel VerticalAlignment="Center">
                            <Border Background="#181D30" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#2D3452" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="SETUP SUMMARY" FontWeight="Bold" FontSize="11" Foreground="#A855F7" Margin="0,0,0,6"/>
                                    <TextBlock Text="• Version: 1.0.0 Production" FontSize="11" Foreground="#CBD5E1" Margin="0,0,0,3"/>
                                    <TextBlock Text="• Engine: KoboldCPP Vulkan" FontSize="11" Foreground="#CBD5E1" Margin="0,0,0,3"/>
                                    <TextBlock Text="• Privacy: 100% Offline" FontSize="11" Foreground="#10B981"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="All components will be extracted and configured for zero-setup execution." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Right Install Configuration -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Install Location Section -->
                        <TextBlock Text="📁 INSTALLATION DIRECTORY" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource SecondaryButton}" Click="Browse_Click" Margin="8,0,0,0" Padding="12,6"/>
                            <TextBox x:Name="TxtInstallPath" TextChanged="TxtInstallPath_TextChanged"
                                     Background="#171B2C" Foreground="#F8FAFC" BorderBrush="#2F3654" Padding="10,6" FontSize="12"/>
                        </DockPanel>

                        <!-- Free Disk Space Indicator -->
                        <TextBlock x:Name="TxtDiskSpace" Text="Calculating disk space..." FontSize="11" Foreground="#64748B" Margin="0,0,0,16"/>

                        <!-- Shortcuts & Preferences -->
                        <StackPanel Margin="0,0,0,18">
                            <CheckBox x:Name="ChkDesktopShortcut" Content="Create Desktop Shortcut" IsChecked="True" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkStartMenuShortcut" Content="Create Start Menu Entry" IsChecked="True" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkLaunchOnFinish" Content="Launch Uncensored Studio after installation" IsChecked="True" Foreground="#CBD5E1" FontSize="12"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <DockPanel>
                            <Button Content="← Back" Style="{StaticResource SecondaryButton}" Click="BackToStep2_Click" DockPanel.Dock="Left" Padding="16,8" Width="90" Margin="0,0,10,0"/>
                            <Button Content="🚀 Install Uncensored Studio" Style="{StaticResource SpicyButton}" Click="StartInstall_Click" Height="44" FontSize="14"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <!-- ============================================================ -->
                <!-- STEP 4: INSTALLATION IN PROGRESS                             -->
                <!-- ============================================================ -->
                <Grid x:Name="Step4_Progress" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="560">
                    <StackPanel>
                        <Border CornerRadius="12" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16" Background="#161A2B" BorderBrush="#3B2658" BorderThickness="1.5">
                            <Image Source="pack://application:,,,/Assets/Logo.png" RenderOptions.BitmapScalingMode="HighQuality" Margin="6"/>
                        </Border>

                        <TextBlock Text="Installing Uncensored Studio..." FontWeight="Bold" FontSize="18" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtProgressStatus" Text="Extracting application files..." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                        <!-- Progress Bar -->
                        <Border Background="#161B2B" CornerRadius="6" BorderBrush="#2D3452" BorderThickness="1" Height="14" Padding="2" Margin="0,0,0,10">
                            <ProgressBar x:Name="ProgressBarInstall" Maximum="100" Value="0" Foreground="{StaticResource SpicyGradientBrush}" BorderThickness="0" Background="Transparent"/>
                        </Border>

                        <TextBlock x:Name="TxtPercent" Text="0%" FontSize="12" Foreground="#A855F7" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ============================================================ -->
                <!-- STEP 5: INSTALLATION COMPLETE                                -->
                <!-- ============================================================ -->
                <Grid x:Name="Step5_Complete" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="560">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Emerald Checkmark Badge -->
                        <Border Background="#064E3B" CornerRadius="36" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,16" BorderBrush="#059669" BorderThickness="1.5">
                            <TextBlock Text="✓" FontSize="36" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Installation Complete!" FontWeight="Bold" FontSize="22" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Uncensored Studio has been successfully installed and is ready to create." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <Border Background="#121626" CornerRadius="8" BorderBrush="#252C48" BorderThickness="1" Padding="14,10" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <TextBlock x:Name="TxtInstalledPathSummary" Text="Installed to: C:\..." FontSize="11" Foreground="#38BDF8"/>
                        </Border>

                        <Button Content="✨ Enter Studio &amp; Start Writing 🚀" Style="{StaticResource SpicyButton}" Click="FinishAndLaunch_Click" Height="46" FontSize="15" Width="360"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
